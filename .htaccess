# Apache Configuration for Lehulum Pan-African Tele-ENT

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /lehulum-website/
    
    # Redirect HTTP to HTTPS (uncomment when HTTPS is available)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

# Prevent directory listing
Options -Indexes

# Disable access to sensitive directories
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect sensitive files
<FilesMatch "\.(env|json|sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect database folder
<Directory "/database">
    Order allow,deny
    Deny from all
</Directory>

# Protect includes folder
<Directory "/includes">
    Order allow,deny
    Deny from all
</Directory>

# Protect admin folder - restrict access to admin IPs
<Directory "/admin">
    # Uncomment and modify to restrict admin access by IP
    # Order deny,allow
    # Allow from 192.168.1.0/24
    # Deny from all
</Directory>

# Compress text-based files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json
</IfModule>

# Cache control
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    
    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Disable script execution in upload directories
<Directory "/uploads">
    php_flag engine off
    AddType text/plain .php .phtml .php3 .php4 .php5 .php6 .phps
</Directory>

# Prevent access to logs
<Directory "/logs">
    Order allow,deny
    Deny from all
</Directory>

# Set default character set
AddDefaultCharset utf-8

# Enable CORS for fonts
<FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|svg)$">
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>

# Disable trace and track methods
<IfModule mod_rewrite.c>
    RewriteRule ^(.*)$ - [F]
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
    RewriteRule .* - [F]
</IfModule>
